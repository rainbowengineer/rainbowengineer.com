---
import Base from '../layouts/Base.astro';
import AboutContact from '../components/AboutContact.astro';
import { Content as About } from '../data/about.md';
import { SITE, githubUrl, githubLabel, mailto } from '../site';
---
<Base title="About" description={`About ${SITE.title}: who builds these things and how to get in touch.`}>
  <section class="home-hero">
    <div class="page-head" style="padding: 0">
      <span class="label">About</span>
      <h1>Hi, I'm {SITE.name}.</h1>
      <div class="prose" style="font-size: 19px; max-width: 36em"><About /></div>
    </div>
    <dl class="info">
      <div><dt class="label">Name</dt><dd>{SITE.name}</dd></div>
      <div><dt class="label">Based in</dt><dd>{SITE.basedIn}</dd></div>
      <div><dt class="label">Writes about</dt><dd>{SITE.writesAbout}</dd></div>
      <div><dt class="label">Files</dt><dd><a href={githubUrl}>{githubLabel}</a></dd></div>
      <div><dt class="label">Email</dt><dd><a href={mailto}>{SITE.email}</a></dd></div>
    </dl>
  </section>
  <AboutContact showAbout={false} />
</Base>
